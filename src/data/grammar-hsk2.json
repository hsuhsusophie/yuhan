{
  "attribution": "文法項目は HSK 2 の文法大綱に合わせ、説明と例文はこのアプリ用に書いています。",
  "lessons": [
    {
      "id": "mian",
      "group": "語素",
      "title": "—面",
      "pinyin": "miàn",
      "ja": "「面」は方向のあとに付けて、その側を言います。",
      "examples": [
        { "zh": "前面", "pinyin": "qiánmiàn", "ja": "前" },
        { "zh": "里面有人", "pinyin": "lǐmiàn yǒu rén", "ja": "中に人がいる" }
      ]
    },
    {
      "id": "left-right",
      "group": "名詞",
      "title": "左、右",
      "pinyin": "zuǒ / yòu",
      "ja": "左と右です。側を言うときは「边」や「面」を付けます。",
      "examples": [
        { "zh": "左边", "pinyin": "zuǒbian", "ja": "左側" },
        { "zh": "在右边", "pinyin": "zài yòubian", "ja": "右側にある" }
      ]
    },
    {
      "id": "verb-redup",
      "group": "動詞",
      "title": "動詞の重ね",
      "pinyin": "AA / A一A / A了A",
      "ja": "動詞を重ねると、少しだけする、試しにする、という軽い感じになります。",
      "examples": [
        { "zh": "看看", "pinyin": "kànkan", "ja": "ちょっと見る" },
        { "zh": "想了想", "pinyin": "xiǎng le xiǎng", "ja": "少し考えた" }
      ]
    },
    {
      "id": "abab",
      "group": "動詞",
      "title": "ABAB",
      "pinyin": "",
      "ja": "二字の動詞は、二字ずつ重ねます。",
      "examples": [
        { "zh": "休息休息", "pinyin": "xiūxi xiūxi", "ja": "少し休む" },
        { "zh": "介绍介绍", "pinyin": "jièshào jièshào", "ja": "ちょっと紹介する" }
      ]
    },
    {
      "id": "keneng",
      "group": "動詞",
      "title": "可能",
      "pinyin": "kěnéng",
      "ja": "「かもしれない」です。動詞の前に置きます。",
      "examples": [
        { "zh": "可能下雨", "pinyin": "kěnéng xià yǔ", "ja": "雨が降るかもしれない" },
        { "zh": "他可能不来", "pinyin": "tā kěnéng bù lái", "ja": "彼は来ないかもしれない" }
      ]
    },
    {
      "id": "separable",
      "group": "動詞",
      "title": "離合詞",
      "pinyin": "",
      "ja": "「帮忙」のように、間に別の語を入れられる動詞です。",
      "examples": [
        { "zh": "帮一个忙", "pinyin": "bāng yí ge máng", "ja": "ひと手伝いする" },
        { "zh": "游过泳", "pinyin": "yóu guo yǒng", "ja": "泳いだことがある" }
      ]
    },
    {
      "id": "weishenme",
      "group": "代詞",
      "title": "为什么",
      "pinyin": "wèi shénme",
      "ja": "理由を聞くときは「为什么」です。",
      "examples": [
        { "zh": "你为什么笑？", "pinyin": "nǐ wèi shénme xiào?", "ja": "なぜ笑うの？" },
        { "zh": "为什么不去？", "pinyin": "wèi shénme bú qù?", "ja": "なぜ行かないの？" }
      ]
    },
    {
      "id": "ziji",
      "group": "代詞",
      "title": "自己",
      "pinyin": "zìjǐ",
      "ja": "自分自身です。人のあとに置くと、その人自身を指します。",
      "examples": [
        { "zh": "我自己去", "pinyin": "wǒ zìjǐ qù", "ja": "自分で行く" },
        { "zh": "自己的名字", "pinyin": "zìjǐ de míngzi", "ja": "自分の名前" }
      ]
    },
    {
      "id": "zheyang",
      "group": "代詞",
      "title": "这么、这样",
      "pinyin": "zhème / zhèyàng",
      "ja": "「这么」は程度、「这样」はやり方です。遠いときは「那么」「那样」です。",
      "examples": [
        { "zh": "这么高", "pinyin": "zhème gāo", "ja": "こんなに高い" },
        { "zh": "那样做", "pinyin": "nàyàng zuò", "ja": "そんなふうにやる" }
      ]
    },
    {
      "id": "mei",
      "group": "代詞",
      "title": "每",
      "pinyin": "měi",
      "ja": "「毎」です。助数詞と一緒に使うことが多いです。",
      "examples": [
        { "zh": "每个人", "pinyin": "měi ge rén", "ja": "一人ひとり" },
        { "zh": "每天", "pinyin": "měi tiān", "ja": "毎日" }
      ]
    },
    {
      "id": "adj-redup",
      "group": "形容詞",
      "title": "形容詞の重ね",
      "pinyin": "AA / AABB",
      "ja": "形容詞を重ねると、様子が生き生きします。",
      "examples": [
        { "zh": "高高的", "pinyin": "gāogāo de", "ja": "背が高い様子" },
        { "zh": "高高兴兴", "pinyin": "gāogāo xìngxìng", "ja": "嬉しそうに" }
      ]
    },
    {
      "id": "wan-duo",
      "group": "数詞",
      "title": "万、多",
      "pinyin": "wàn / duō",
      "ja": "「万」は一万です。「多」や「好多」は、はっきり数えない多さです。",
      "examples": [
        { "zh": "一万", "pinyin": "yí wàn", "ja": "一万" },
        { "zh": "好多人", "pinyin": "hǎo duō rén", "ja": "すごく大勢" }
      ]
    },
    {
      "id": "measure-noun",
      "group": "量詞",
      "title": "条、位、间、名",
      "pinyin": "",
      "ja": "物や人に合う助数詞を選びます。「包」は袋も数えます。",
      "examples": [
        { "zh": "一条路", "pinyin": "yì tiáo lù", "ja": "一本の道" },
        { "zh": "一位老师", "pinyin": "yí wèi lǎoshī", "ja": "先生お一方" }
      ]
    },
    {
      "id": "ci",
      "group": "量詞",
      "title": "次",
      "pinyin": "cì",
      "ja": "動作の回数です。動詞のあと、または目的語の前に置きます。",
      "examples": [
        { "zh": "去一次", "pinyin": "qù yí cì", "ja": "一回行く" },
        { "zh": "看了三次", "pinyin": "kàn le sān cì", "ja": "三回見ました" }
      ]
    },
    {
      "id": "degree",
      "group": "副詞",
      "title": "最、好、多",
      "pinyin": "zuì / hǎo / duō",
      "ja": "程度を強めます。「最」がいちばん、「好」は口語でとても、「多」は疑問や感嘆でどのくらいです。",
      "examples": [
        { "zh": "最高", "pinyin": "zuì gāo", "ja": "いちばん高い" },
        { "zh": "多高？", "pinyin": "duō gāo?", "ja": "どのくらい高い？" }
      ]
    },
    {
      "id": "yiqi",
      "group": "副詞",
      "title": "一起",
      "pinyin": "yìqǐ",
      "ja": "一緒に、です。動詞の前に置きます。",
      "examples": [
        { "zh": "一起去", "pinyin": "yìqǐ qù", "ja": "一緒に行く" },
        { "zh": "一起吃饭", "pinyin": "yìqǐ chī fàn", "ja": "一緒にご飯を食べる" }
      ]
    },
    {
      "id": "time-adv",
      "group": "副詞",
      "title": "已经、正、快要",
      "pinyin": "",
      "ja": "「已经」はすでに、「正」はちょうど今、「快要……了」はもうすぐです。",
      "examples": [
        { "zh": "已经走了", "pinyin": "yǐjīng zǒu le", "ja": "もう行った" },
        { "zh": "快要考试了", "pinyin": "kuàiyào kǎoshì le", "ja": "もうすぐ試験だ" }
      ]
    },
    {
      "id": "you-shi",
      "group": "副詞",
      "title": "有时、还",
      "pinyin": "yǒushí / hái",
      "ja": "「有时」はときどきです。「还」は、まだ続いていることを言います。",
      "examples": [
        { "zh": "有时很忙", "pinyin": "yǒushí hěn máng", "ja": "ときどきとても忙しい" },
        { "zh": "他还在学校", "pinyin": "tā hái zài xuéxiào", "ja": "彼はまだ学校にいる" }
      ]
    },
    {
      "id": "jingchang",
      "group": "副詞",
      "title": "经常",
      "pinyin": "jīngcháng",
      "ja": "よく、たびたびです。動詞の前に置きます。",
      "examples": [
        { "zh": "经常运动", "pinyin": "jīngcháng yùndòng", "ja": "よく運動する" },
        { "zh": "不经常去", "pinyin": "bù jīngcháng qù", "ja": "あまり行かない" }
      ]
    },
    {
      "id": "bie",
      "group": "副詞",
      "title": "别",
      "pinyin": "bié",
      "ja": "しないで、という禁止です。動詞の前に置きます。",
      "examples": [
        { "zh": "别走", "pinyin": "bié zǒu", "ja": "行かないで" },
        { "zh": "别忘了", "pinyin": "bié wàng le", "ja": "忘れないで" }
      ]
    },
    {
      "id": "jiu-zai",
      "group": "副詞",
      "title": "就、再",
      "pinyin": "jiù / zài",
      "ja": "「就」はすぐに、そこで。「再」はもう一度、このあとまた、です。",
      "examples": [
        { "zh": "来了就说", "pinyin": "lái le jiù shuō", "ja": "来たらすぐ言う" },
        { "zh": "再看一次", "pinyin": "zài kàn yí cì", "ja": "もう一回見る" }
      ]
    },
    {
      "id": "hai-shi",
      "group": "副詞",
      "title": "还是",
      "pinyin": "háishi",
      "ja": "選択の「それとも」と、やはり、の二つがあります。",
      "examples": [
        { "zh": "茶还是咖啡？", "pinyin": "chá háishi kāfēi?", "ja": "お茶、それともコーヒー？" },
        { "zh": "还是你去吧", "pinyin": "háishi nǐ qù ba", "ja": "やっぱり君が行って" }
      ]
    },
    {
      "id": "cong-wang",
      "group": "介詞",
      "title": "从、往",
      "pinyin": "cóng / wǎng",
      "ja": "「从」は起点、「往」は向かう方向です。",
      "examples": [
        { "zh": "从学校来", "pinyin": "cóng xuéxiào lái", "ja": "学校から来る" },
        { "zh": "往前走", "pinyin": "wǎng qián zǒu", "ja": "前のほうへ歩く" }
      ]
    },
    {
      "id": "gei-gen",
      "group": "介詞",
      "title": "给、跟",
      "pinyin": "gěi / gēn",
      "ja": "「给」は相手に渡す・してあげる方向、「跟」は一緒に、または〜と、です。",
      "examples": [
        { "zh": "给我看看", "pinyin": "gěi wǒ kànkan", "ja": "私に見せて" },
        { "zh": "跟朋友去", "pinyin": "gēn péngyou qù", "ja": "友達と行く" }
      ]
    },
    {
      "id": "bi-yinwei",
      "group": "介詞",
      "title": "比、因为",
      "pinyin": "bǐ / yīnwèi",
      "ja": "「比」は比較の相手、「因为」は理由を導きます。",
      "examples": [
        { "zh": "他比我高", "pinyin": "tā bǐ wǒ gāo", "ja": "彼は私より背が高い" },
        { "zh": "因为下雨", "pinyin": "yīnwèi xià yǔ", "ja": "雨が降るので" }
      ]
    },
    {
      "id": "conjunctions",
      "group": "接続",
      "title": "但是、所以",
      "pinyin": "",
      "ja": "逆接は「虽然……，但是……」。理由と結果は「因为……，所以……」です。",
      "examples": [
        { "zh": "虽然累，但是很高兴", "pinyin": "suīrán lèi, dànshì hěn gāoxìng", "ja": "疲れたけど、とても嬉しい" },
        { "zh": "因为忙，所以没去", "pinyin": "yīnwèi máng, suǒyǐ méi qù", "ja": "忙しかったので行かなかった" }
      ]
    },
    {
      "id": "de-di",
      "group": "助詞",
      "title": "得、地",
      "pinyin": "de",
      "ja": "「得」は動作の結果や様子を後ろに導きます。「地」は、前の語を連用にして動詞を修飾します。",
      "examples": [
        { "zh": "说得很慢", "pinyin": "shuō de hěn màn", "ja": "とてもゆっくり話す" },
        { "zh": "慢慢地走", "pinyin": "mànmàn de zǒu", "ja": "ゆっくり歩く" }
      ]
    },
    {
      "id": "guo",
      "group": "助詞",
      "title": "过",
      "pinyin": "guo",
      "ja": "経験です。したことがある、というときに動詞のあとに付けます。",
      "examples": [
        { "zh": "去过中国", "pinyin": "qù guo Zhōngguó", "ja": "中国へ行ったことがある" },
        { "zh": "没吃过", "pinyin": "méi chī guo", "ja": "食べたことがない" }
      ]
    },
    {
      "id": "zhe",
      "group": "助詞",
      "title": "着",
      "pinyin": "zhe",
      "ja": "動作や状態が続いていることを表します。",
      "examples": [
        { "zh": "门开着", "pinyin": "mén kāi zhe", "ja": "ドアが開いたまま" },
        { "zh": "看着书", "pinyin": "kàn zhe shū", "ja": "本を読んでいる" }
      ]
    },
    {
      "id": "particles",
      "group": "助詞",
      "title": "啊、呢、吧",
      "pinyin": "",
      "ja": "文の調子を足します。「啊」は感嘆、「呢」は問い返しや対照、「吧」は提案や推量です。",
      "examples": [
        { "zh": "好啊", "pinyin": "hǎo a", "ja": "いいね" },
        { "zh": "走吧", "pinyin": "zǒu ba", "ja": "行こう" }
      ]
    },
    {
      "id": "result-comp",
      "group": "補語",
      "title": "結果補語",
      "pinyin": "",
      "ja": "動詞のあとで、その結果を言います。完、懂、错、好などがよく付きます。",
      "examples": [
        { "zh": "做完了", "pinyin": "zuò wán le", "ja": "やり終えた" },
        { "zh": "听懂了", "pinyin": "tīng dǒng le", "ja": "聞いてわかった" }
      ]
    },
    {
      "id": "direction-simple",
      "group": "補語",
      "title": "来、去",
      "pinyin": "lái / qù",
      "ja": "動詞のあとで、こちらへ来るか、向こうへ行くかを足します。",
      "examples": [
        { "zh": "回来", "pinyin": "huílái", "ja": "戻ってくる" },
        { "zh": "进去", "pinyin": "jìnqù", "ja": "入っていく" }
      ]
    },
    {
      "id": "direction-compound",
      "group": "補語",
      "title": "上来、下去",
      "pinyin": "",
      "ja": "方向の動詞と「来・去」を重ねて、動きの向きを細かく言います。",
      "examples": [
        { "zh": "走出来", "pinyin": "zǒu chūlái", "ja": "歩いて出てくる" },
        { "zh": "拿回去", "pinyin": "ná huíqù", "ja": "持って帰っていく" }
      ]
    },
    {
      "id": "state-comp",
      "group": "補語",
      "title": "状態補語",
      "pinyin": "得",
      "ja": "動作がどのように行われたかを、「得」のあとに言います。",
      "examples": [
        { "zh": "跑得很快", "pinyin": "pǎo de hěn kuài", "ja": "走るのがとても速い" },
        { "zh": "写得不对", "pinyin": "xiě de bú duì", "ja": "書き方が正しくない" }
      ]
    },
    {
      "id": "time-comp",
      "group": "補語",
      "title": "時間の補語",
      "pinyin": "",
      "ja": "動作がどれだけ続いたかを、動詞のあとに置きます。形容詞のあとにも長さを置けます。",
      "examples": [
        { "zh": "学了一年", "pinyin": "xué le yì nián", "ja": "一年学んだ" },
        { "zh": "大两岁", "pinyin": "dà liǎng suì", "ja": "二つ年上" }
      ]
    },
    {
      "id": "de-phrase",
      "group": "フレーズ",
      "title": "「的」の句",
      "pinyin": "de",
      "ja": "「的」の前だけで、人や物を指せます。名詞を省いた形です。",
      "examples": [
        { "zh": "红的", "pinyin": "hóng de", "ja": "赤いほう" },
        { "zh": "我买的", "pinyin": "wǒ mǎi de", "ja": "私が買ったもの" }
      ]
    },
    {
      "id": "serial-verb",
      "group": "フレーズ",
      "title": "連動文",
      "pinyin": "",
      "ja": "一つの主語が、目的を持って続けて二つの動作をします。",
      "examples": [
        { "zh": "去商店买水", "pinyin": "qù shāngdiàn mǎi shuǐ", "ja": "店へ水を買いに行く" },
        { "zh": "坐地铁回家", "pinyin": "zuò dìtiě huí jiā", "ja": "地下鉄で家に帰る" }
      ]
    },
    {
      "id": "pivotal",
      "group": "フレーズ",
      "title": "兼語",
      "pinyin": "",
      "ja": "「请・叫・让」の目的語が、次の動詞の主語になります。",
      "examples": [
        { "zh": "请他进来", "pinyin": "qǐng tā jìnlái", "ja": "彼に入ってくるよう頼む" },
        { "zh": "让我看看", "pinyin": "ràng wǒ kànkan", "ja": "私に見させて" }
      ]
    },
    {
      "id": "shenme-de",
      "group": "フレーズ",
      "title": "什么的",
      "pinyin": "shénme de",
      "ja": "例を挙げたあと、など、とぼかします。",
      "examples": [
        { "zh": "茶、咖啡什么的", "pinyin": "chá, kāfēi shénme de", "ja": "お茶やコーヒーなど" },
        { "zh": "看书什么的", "pinyin": "kàn shū shénme de", "ja": "本を読むとか、そういうこと" }
      ]
    },
    {
      "id": "fixed",
      "group": "言い方",
      "title": "都……了",
      "pinyin": "",
      "ja": "「都……了」は、すでにそうなのに、という驚きです。「要……了」は、まもなく起きる変化です。",
      "examples": [
        { "zh": "都十二点了", "pinyin": "dōu shí'èr diǎn le", "ja": "もう十二時だよ" },
        { "zh": "要下雨了", "pinyin": "yào xià yǔ le", "ja": "雨が降りそうだ" }
      ]
    },
    {
      "id": "patient-subject",
      "group": "文の成分",
      "title": "受け身の主語",
      "pinyin": "",
      "ja": "動作を受ける物を、主語に置けます。",
      "examples": [
        { "zh": "书看完了", "pinyin": "shū kàn wán le", "ja": "本は読み終わった" },
        { "zh": "饭做好了", "pinyin": "fàn zuò hǎo le", "ja": "ご飯はできた" }
      ]
    },
    {
      "id": "nominal-pred",
      "group": "文の成分",
      "title": "名詞が述語",
      "pinyin": "",
      "ja": "日付、年齢、出身のように、「是」を使わず名詞で述語にできます。",
      "examples": [
        { "zh": "今天星期一", "pinyin": "jīntiān xīngqīyī", "ja": "今日は月曜日" },
        { "zh": "他二十岁", "pinyin": "tā èrshí suì", "ja": "彼は二十歳" }
      ]
    },
    {
      "id": "verb-attr",
      "group": "文の成分",
      "title": "動詞が連体",
      "pinyin": "",
      "ja": "動詞や文も、「的」を付けて名詞を修飾できます。",
      "examples": [
        { "zh": "来的人", "pinyin": "lái de rén", "ja": "来る人" },
        { "zh": "我认识的老师", "pinyin": "wǒ rènshi de lǎoshī", "ja": "私が知っている先生" }
      ]
