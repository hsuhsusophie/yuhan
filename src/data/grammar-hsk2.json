{
  "attribution": "文法項目は HSK 2 の文法大綱に合わせ、説明と例文はこのアプリ用に書いています。",
  "lessons": [
    {
      "id": "mian",
      "group": "語素",
      "title": "—面",
      "pinyin": "miàn",
      "ja": "「面」は方向のあとに付けて、その側を言います。",
      "examples": [
        {
          "zh": "前面",
          "pinyin": "qiánmiàn",
          "ja": "前"
        },
        {
          "zh": "裡面有人",
          "pinyin": "lǐmiàn yǒu rén",
          "ja": "中に人がいる"
        }
      ]
    },
    {
      "id": "left-right",
      "group": "名詞",
      "title": "左、右",
      "pinyin": "zuǒ / yòu",
      "ja": "左と右です。側を言うときは「邊」や「面」を付けます。",
      "examples": [
        {
          "zh": "左邊",
          "pinyin": "zuǒbian",
          "ja": "左側"
        },
        {
          "zh": "在右邊",
          "pinyin": "zài yòubian",
          "ja": "右側にある"
        }
      ]
    },
    {
      "id": "verb-redup",
      "group": "動詞",
      "title": "動詞の重ね",
      "pinyin": "AA / A一A / A了A",
      "ja": "動詞を重ねると、少しだけする、試しにする、という軽い感じになります。",
      "examples": [
        {
          "zh": "看看",
          "pinyin": "kànkan",
          "ja": "ちょっと見る"
        },
        {
          "zh": "想了想",
          "pinyin": "xiǎng le xiǎng",
          "ja": "少し考えた"
        }
      ]
    },
    {
      "id": "abab",
      "group": "動詞",
      "title": "ABAB",
      "pinyin": "",
      "ja": "二字の動詞は、二字ずつ重ねます。",
      "examples": [
        {
          "zh": "休息休息",
          "pinyin": "xiūxi xiūxi",
          "ja": "少し休む"
        },
        {
          "zh": "介紹介紹",
          "pinyin": "jièshào jièshào",
          "ja": "ちょっと紹介する"
        }
      ]
    },
    {
      "id": "keneng",
      "group": "動詞",
      "title": "可能",
      "pinyin": "kěnéng",
      "ja": "「かもしれない」です。動詞の前に置きます。",
      "examples": [
        {
          "zh": "可能下雨",
          "pinyin": "kěnéng xià yǔ",
          "ja": "雨が降るかもしれない"
        },
        {
          "zh": "他可能不來",
          "pinyin": "tā kěnéng bù lái",
          "ja": "彼は来ないかもしれない"
        }
      ]
    },
    {
      "id": "separable",
      "group": "動詞",
      "title": "離合詞",
      "pinyin": "",
      "ja": "「幫忙」のように、間に別の語を入れられる動詞です。",
      "examples": [
        {
          "zh": "幫一個忙",
          "pinyin": "bāng yí ge máng",
          "ja": "ひと手伝いする"
        },
        {
          "zh": "遊過泳",
          "pinyin": "yóu guo yǒng",
          "ja": "泳いだことがある"
        }
      ]
    },
    {
      "id": "weishenme",
      "group": "代詞",
      "title": "為什麼",
      "pinyin": "wèi shénme",
      "ja": "理由を聞くときは「為什麼」です。",
      "examples": [
        {
          "zh": "你為什麼笑？",
          "pinyin": "nǐ wèi shénme xiào?",
          "ja": "なぜ笑うの？"
        },
        {
          "zh": "為什麼不去？",
          "pinyin": "wèi shénme bú qù?",
          "ja": "なぜ行かないの？"
        }
      ]
    },
    {
      "id": "ziji",
      "group": "代詞",
      "title": "自己",
      "pinyin": "zìjǐ",
      "ja": "自分自身です。人のあとに置くと、その人自身を指します。",
      "examples": [
        {
          "zh": "我自己去",
          "pinyin": "wǒ zìjǐ qù",
          "ja": "自分で行く"
        },
        {
          "zh": "自己的名字",
          "pinyin": "zìjǐ de míngzi",
          "ja": "自分の名前"
        }
      ]
    },
    {
      "id": "zheyang",
      "group": "代詞",
      "title": "這麼、這樣",
      "pinyin": "zhème / zhèyàng",
      "ja": "「這麼」は程度、「這樣」はやり方です。遠いときは「那麼」「那樣」です。",
      "examples": [
        {
          "zh": "這麼高",
          "pinyin": "zhème gāo",
          "ja": "こんなに高い"
        },
        {
          "zh": "那樣做",
          "pinyin": "nàyàng zuò",
          "ja": "そんなふうにやる"
        }
      ]
    },
    {
      "id": "mei",
      "group": "代詞",
      "title": "每",
      "pinyin": "měi",
      "ja": "「毎」です。助数詞と一緒に使うことが多いです。",
      "examples": [
        {
          "zh": "每個人",
          "pinyin": "měi ge rén",
          "ja": "一人ひとり"
        },
        {
          "zh": "每天",
          "pinyin": "měi tiān",
          "ja": "毎日"
        }
      ]
    },
    {
      "id": "adj-redup",
      "group": "形容詞",
      "title": "形容詞の重ね",
      "pinyin": "AA / AABB",
      "ja": "形容詞を重ねると、様子が生き生きします。",
      "examples": [
        {
          "zh": "高高的",
          "pinyin": "gāogāo de",
          "ja": "背が高い様子"
        },
        {
          "zh": "高高興興",
          "pinyin": "gāogāo xìngxìng",
          "ja": "嬉しそうに"
        }
      ]
    },
    {
      "id": "wan-duo",
      "group": "数詞",
      "title": "萬、多",
      "pinyin": "wàn / duō",
      "ja": "「萬」は一万です。「多」や「好多」は、はっきり数えない多さです。",
      "examples": [
        {
          "zh": "一萬",
          "pinyin": "yí wàn",
          "ja": "一万"
        },
        {
          "zh": "好多人",
          "pinyin": "hǎo duō rén",
          "ja": "すごく大勢"
        }
      ]
    },
    {
      "id": "measure-noun",
      "group": "量詞",
      "title": "條、位、間、名",
      "pinyin": "",
      "ja": "物や人に合う助数詞を選びます。「包」は袋も数えます。",
      "examples": [
        {
          "zh": "一條路",
          "pinyin": "yì tiáo lù",
          "ja": "一本の道"
        },
        {
          "zh": "一位老師",
          "pinyin": "yí wèi lǎoshī",
          "ja": "先生お一方"
        }
      ]
    },
    {
      "id": "ci",
      "group": "量詞",
      "title": "次",
      "pinyin": "cì",
      "ja": "動作の回数です。動詞のあと、または目的語の前に置きます。",
      "examples": [
        {
          "zh": "去一次",
          "pinyin": "qù yí cì",
          "ja": "一回行く"
        },
        {
          "zh": "看了三次",
          "pinyin": "kàn le sān cì",
          "ja": "三回見ました"
        }
      ]
    },
    {
      "id": "degree",
      "group": "副詞",
      "title": "最、好、多",
      "pinyin": "zuì / hǎo / duō",
      "ja": "程度を強めます。「最」がいちばん、「好」は口語でとても、「多」は疑問や感嘆でどのくらいです。",
      "examples": [
        {
          "zh": "最高",
          "pinyin": "zuì gāo",
          "ja": "いちばん高い"
        },
        {
          "zh": "多高？",
          "pinyin": "duō gāo?",
          "ja": "どのくらい高い？"
        }
      ]
    },
    {
      "id": "yiqi",
      "group": "副詞",
      "title": "一起",
      "pinyin": "yìqǐ",
      "ja": "一緒に、です。動詞の前に置きます。",
      "examples": [
        {
          "zh": "一起去",
          "pinyin": "yìqǐ qù",
          "ja": "一緒に行く"
        },
        {
          "zh": "一起吃飯",
          "pinyin": "yìqǐ chī fàn",
          "ja": "一緒にご飯を食べる"
        }
      ]
    },
    {
      "id": "time-adv",
      "group": "副詞",
      "title": "已經、正、快要",
      "pinyin": "",
      "ja": "「已經」はすでに、「正」はちょうど今、「快要……了」はもうすぐです。",
      "examples": [
        {
          "zh": "已經走了",
          "pinyin": "yǐjīng zǒu le",
          "ja": "もう行った"
        },
        {
          "zh": "快要考試了",
          "pinyin": "kuàiyào kǎoshì le",
          "ja": "もうすぐ試験だ"
        }
      ]
    },
    {
      "id": "you-shi",
      "group": "副詞",
      "title": "有時、還",
      "pinyin": "yǒushí / hái",
      "ja": "「有時」はときどきです。「還」は、まだ続いていることを言います。",
      "examples": [
        {
          "zh": "有時很忙",
          "pinyin": "yǒushí hěn máng",
          "ja": "ときどきとても忙しい"
        },
        {
          "zh": "他還在學校",
          "pinyin": "tā hái zài xuéxiào",
          "ja": "彼はまだ学校にいる"
        }
      ]
    },
    {
      "id": "jingchang",
      "group": "副詞",
      "title": "經常",
      "pinyin": "jīngcháng",
      "ja": "よく、たびたびです。動詞の前に置きます。",
      "examples": [
        {
          "zh": "經常運動",
          "pinyin": "jīngcháng yùndòng",
          "ja": "よく運動する"
        },
        {
          "zh": "不經常去",
          "pinyin": "bù jīngcháng qù",
          "ja": "あまり行かない"
        }
      ]
    },
    {
      "id": "bie",
      "group": "副詞",
      "title": "別",
      "pinyin": "bié",
      "ja": "しないで、という禁止です。動詞の前に置きます。",
      "examples": [
        {
          "zh": "別走",
          "pinyin": "bié zǒu",
          "ja": "行かないで"
        },
        {
          "zh": "別忘了",
          "pinyin": "bié wàng le",
          "ja": "忘れないで"
        }
      ]
    },
    {
      "id": "jiu-zai",
      "group": "副詞",
      "title": "就、再",
      "pinyin": "jiù / zài",
      "ja": "「就」はすぐに、そこで。「再」はもう一度、このあとまた、です。",
      "examples": [
        {
          "zh": "來了就說",
          "pinyin": "lái le jiù shuō",
          "ja": "来たらすぐ言う"
        },
        {
          "zh": "再看一次",
          "pinyin": "zài kàn yí cì",
          "ja": "もう一回見る"
        }
      ]
    },
    {
      "id": "hai-shi",
      "group": "副詞",
      "title": "還是",
      "pinyin": "háishi",
      "ja": "選択の「それとも」と、やはり、の二つがあります。",
      "examples": [
        {
          "zh": "茶還是咖啡？",
          "pinyin": "chá háishi kāfēi?",
          "ja": "お茶、それともコーヒー？"
        },
        {
          "zh": "還是你去吧",
          "pinyin": "háishi nǐ qù ba",
          "ja": "やっぱり君が行って"
        }
      ]
    },
    {
      "id": "cong-wang",
      "group": "介詞",
      "title": "從、往",
      "pinyin": "cóng / wǎng",
      "ja": "「從」は起点、「往」は向かう方向です。",
      "examples": [
        {
          "zh": "從學校來",
          "pinyin": "cóng xuéxiào lái",
          "ja": "学校から来る"
        },
        {
          "zh": "往前走",
          "pinyin": "wǎng qián zǒu",
          "ja": "前のほうへ歩く"
        }
      ]
    },
    {
      "id": "gei-gen",
      "group": "介詞",
      "title": "給、跟",
      "pinyin": "gěi / gēn",
      "ja": "「給」は相手に渡す・してあげる方向、「跟」は一緒に、または〜と、です。",
      "examples": [
        {
          "zh": "給我看看",
          "pinyin": "gěi wǒ kànkan",
          "ja": "私に見せて"
        },
        {
          "zh": "跟朋友去",
          "pinyin": "gēn péngyou qù",
          "ja": "友達と行く"
        }
      ]
    },
    {
      "id": "bi-yinwei",
      "group": "介詞",
      "title": "比、因為",
      "pinyin": "bǐ / yīnwèi",
      "ja": "「比」は比較の相手、「因為」は理由を導きます。",
      "examples": [
        {
          "zh": "他比我高",
          "pinyin": "tā bǐ wǒ gāo",
          "ja": "彼は私より背が高い"
        },
        {
          "zh": "因為下雨",
          "pinyin": "yīnwèi xià yǔ",
          "ja": "雨が降るので"
        }
      ]
    },
    {
      "id": "conjunctions",
      "group": "接続",
      "title": "但是、所以",
      "pinyin": "",
      "ja": "逆接は「雖然……，但是……」。理由と結果は「因為……，所以……」です。",
      "examples": [
        {
          "zh": "雖然累，但是很高興",
          "pinyin": "suīrán lèi, dànshì hěn gāoxìng",
          "ja": "疲れたけど、とても嬉しい"
        },
        {
          "zh": "因為忙，所以沒去",
          "pinyin": "yīnwèi máng, suǒyǐ méi qù",
          "ja": "忙しかったので行かなかった"
        }
      ]
    },
    {
      "id": "de-di",
      "group": "助詞",
      "title": "得、地",
      "pinyin": "de",
      "ja": "「得」は動作の結果や様子を後ろに導きます。「地」は、前の語を連用にして動詞を修飾します。",
      "examples": [
        {
          "zh": "說得很慢",
          "pinyin": "shuō de hěn màn",
          "ja": "とてもゆっくり話す"
        },
        {
          "zh": "慢慢地走",
          "pinyin": "mànmàn de zǒu",
          "ja": "ゆっくり歩く"
        }
      ]
    },
    {
      "id": "guo",
      "group": "助詞",
      "title": "過",
      "pinyin": "guo",
      "ja": "経験です。したことがある、というときに動詞のあとに付けます。",
      "examples": [
        {
          "zh": "去過中國",
          "pinyin": "qù guo Zhōngguó",
          "ja": "中国へ行ったことがある"
        },
        {
          "zh": "沒吃過",
          "pinyin": "méi chī guo",
          "ja": "食べたことがない"
        }
      ]
    },
    {
      "id": "zhe",
      "group": "助詞",
      "title": "著",
      "pinyin": "zhe",
      "ja": "動作や状態が続いていることを表します。",
      "examples": [
        {
          "zh": "門開著",
          "pinyin": "mén kāi zhe",
          "ja": "ドアが開いたまま"
        },
        {
          "zh": "看著書",
          "pinyin": "kàn zhe shū",
          "ja": "本を読んでいる"
        }
      ]
    },
    {
      "id": "particles",
      "group": "助詞",
      "title": "啊、呢、吧",
      "pinyin": "",
      "ja": "文の調子を足します。「啊」は感嘆、「呢」は問い返しや対照、「吧」は提案や推量です。",
      "examples": [
        {
          "zh": "好啊",
          "pinyin": "hǎo a",
          "ja": "いいね"
        },
        {
          "zh": "走吧",
          "pinyin": "zǒu ba",
          "ja": "行こう"
        }
      ]
    },
    {
      "id": "result-comp",
      "group": "補語",
      "title": "結果補語",
      "pinyin": "",
      "ja": "動詞のあとで、その結果を言います。完、懂、错、好などがよく付きます。",
      "examples": [
        {
          "zh": "做完了",
          "pinyin": "zuò wán le",
          "ja": "やり終えた"
        },
        {
          "zh": "聽懂了",
          "pinyin": "tīng dǒng le",
          "ja": "聞いてわかった"
        }
      ]
    },
    {
      "id": "direction-simple",
      "group": "補語",
      "title": "來、去",
      "pinyin": "lái / qù",
      "ja": "動詞のあとで、こちらへ来るか、向こうへ行くかを足します。",
      "examples": [
        {
          "zh": "回來",
          "pinyin": "huílái",
          "ja": "戻ってくる"
        },
        {
          "zh": "進去",
          "pinyin": "jìnqù",
          "ja": "入っていく"
        }
      ]
    },
    {
      "id": "direction-compound",
      "group": "補語",
      "title": "上來、下去",
      "pinyin": "",
      "ja": "方向の動詞と「來・去」を重ねて、動きの向きを細かく言います。",
      "examples": [
        {
          "zh": "走出來",
          "pinyin": "zǒu chūlái",
          "ja": "歩いて出てくる"
        },
        {
          "zh": "拿回去",
          "pinyin": "ná huíqù",
          "ja": "持って帰っていく"
        }
      ]
    },
    {
      "id": "state-comp",
      "group": "補語",
      "title": "状態補語",
      "pinyin": "得",
      "ja": "動作がどのように行われたかを、「得」のあとに言います。",
      "examples": [
        {
          "zh": "跑得很快",
          "pinyin": "pǎo de hěn kuài",
          "ja": "走るのがとても速い"
        },
        {
          "zh": "寫得不對",
          "pinyin": "xiě de bú duì",
          "ja": "書き方が正しくない"
        }
      ]
    },
    {
      "id": "time-comp",
      "group": "補語",
      "title": "時間の補語",
      "pinyin": "",
      "ja": "動作がどれだけ続いたかを、動詞のあとに置きます。形容詞のあとにも長さを置けます。",
      "examples": [
        {
          "zh": "學了一年",
          "pinyin": "xué le yì nián",
          "ja": "一年学んだ"
        },
        {
          "zh": "大兩歲",
          "pinyin": "dà liǎng suì",
          "ja": "二つ年上"
        }
      ]
    },
    {
      "id": "de-phrase",
      "group": "フレーズ",
      "title": "「的」の句",
      "pinyin": "de",
      "ja": "「的」の前だけで、人や物を指せます。名詞を省いた形です。",
      "examples": [
        {
          "zh": "紅的",
          "pinyin": "hóng de",
          "ja": "赤いほう"
        },
        {
          "zh": "我買的",
          "pinyin": "wǒ mǎi de",
          "ja": "私が買ったもの"
        }
      ]
    },
    {
      "id": "serial-verb",
      "group": "フレーズ",
      "title": "連動文",
      "pinyin": "",
      "ja": "一つの主語が、目的を持って続けて二つの動作をします。",
      "examples": [
        {
          "zh": "去商店買水",
          "pinyin": "qù shāngdiàn mǎi shuǐ",
          "ja": "店へ水を買いに行く"
        },
        {
          "zh": "坐地鐵回家",
          "pinyin": "zuò dìtiě huí jiā",
          "ja": "地下鉄で家に帰る"
        }
      ]
    },
    {
      "id": "pivotal",
      "group": "フレーズ",
      "title": "兼語",
      "pinyin": "",
      "ja": "「請・叫・讓」の目的語が、次の動詞の主語になります。",
      "examples": [
        {
          "zh": "請他進來",
          "pinyin": "qǐng tā jìnlái",
          "ja": "彼に入ってくるよう頼む"
        },
        {
          "zh": "讓我看看",
          "pinyin": "ràng wǒ kànkan",
